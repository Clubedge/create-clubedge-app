{
  "name": "@clubedge/create-clubedge-app",
  "version": "0.7.0",
  "description": "Create a Next.js or TanStack Start application from the Clubedge Starter reference implementation.",
  "type": "module",
  "packageManager": "pnpm@10.9.0",
  "bin": {
    "create-clubedge-app": "./bin/create.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "template/",
    "template.lock.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "clubedge": {
    "starterRepository": "Clubedge/clubedge-starter",
    "starterRef": "v0.7.0",
    "starterCommit": "3b8114760b8151c2538b57c06620ff2b884f2d56"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Clubedge/create-clubedge-app.git"
  },
  "homepage": "https://github.com/Clubedge/create-clubedge-app#readme",
  "bugs": {
    "url": "https://github.com/Clubedge/create-clubedge-app/issues"
  },
  "keywords": [
    "create-clubedge-app",
    "clubedge",
    "nextjs",
    "tanstack-start",
    "starter",
    "scaffolding"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "bundle-template": "node scripts/bundle-template.mjs",
    "start": "pnpm build && node ./bin/create.mjs",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "giget": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
