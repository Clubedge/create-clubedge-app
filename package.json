{
  "name": "@clubedge/create-clubedge-app",
  "version": "0.37.0",
  "description": "Create React apps from Clubedge Starter with a CLI or local MCP server.",
  "type": "module",
  "packageManager": "pnpm@10.9.0",
  "bin": {
    "create-clubedge-app": "./bin/create.mjs",
    "create-clubedge-app-mcp": "./bin/mcp.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "template/",
    "template.lock.json",
    "skills/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "clubedge": {
    "starterRepository": "Clubedge/clubedge-starter",
    "starterRef": "v0.24.2",
    "starterCommit": "4450d2f00a89f1a3929a5c9d2c1541e0d65df891"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Clubedge/create-clubedge-app.git"
  },
  "homepage": "https://github.com/Clubedge/create-clubedge-app#readme",
  "bugs": {
    "url": "https://github.com/Clubedge/create-clubedge-app/issues"
  },
  "keywords": [
    "create-clubedge-app",
    "clubedge",
    "nextjs",
    "tanstack-start",
    "starter",
    "scaffolding",
    "mcp",
    "model-context-protocol",
    "ai-agent"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "bundle-template": "node scripts/bundle-template.mjs",
    "start": "pnpm build && node ./bin/create.mjs",
    "prepack": "pnpm build",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@clack/prompts": "^1.8.1",
    "giget": "^3.3.1",
    "node-diff3": "^3.2.1",
    "ssh2": "^1.17.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ssh2": "^1.15.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
